# Salin file ini menjadi  secrets/x_accounts.yaml  lalu isi.
# JANGAN commit file asli (folder secrets/ sudah di .gitignore).
#
# Tips anti-limit:
#   - Pakai beberapa akun cadangan (semakin banyak, semakin tahan).
#   - Sebaiknya tiap akun pakai proxy berbeda (residential lebih aman).
#   - Akun baru rawan dikunci; pakai akun yang sudah "berumur".

accounts:
  - username: "akun_cadangan_1"
    email: "email1@example.com"
    password: "password1"
    proxy: ""                       # contoh: "http://user:pass@host:port"

  - username: "akun_cadangan_2"
    email: "email2@example.com"
    password: "password2"
    proxy: ""
