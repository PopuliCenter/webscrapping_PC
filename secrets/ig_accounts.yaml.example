# Salin menjadi  secrets/ig_accounts.yaml  lalu isi.
# JANGAN commit file asli (sudah di .gitignore).
#
# Instagram sangat agresif membatasi:
#   - Pakai akun cadangan (BUKAN akun utama) — risiko challenge/blokir.
#   - Sesi login otomatis di-cache di data/ig_sessions/ (login jarang = aman).
#   - Set jeda besar di config (min/max_delay_sec) & posts_per_tag kecil.

accounts:
  - username: "akun_ig_cadangan"
    password: "password_ig"
