# Salin menjadi  secrets/email.yaml  lalu isi.
# JANGAN commit file asli (sudah di .gitignore).
#
# Gmail: WAJIB pakai App Password, bukan kata sandi akunmu.
#   1. Aktifkan verifikasi 2 langkah di akun Google.
#   2. Buat App Password: https://myaccount.google.com/apppasswords
#   3. Tempel 16 karakter itu di bawah (tanpa spasi).
#
# Port 465 = SSL, port 587 = STARTTLS. Keduanya didukung.

host: "smtp.gmail.com"
port: 465
user: "alamat@gmail.com"
password: "app-password-16-karakter"
dari: ""            # opsional; kosong = pakai `user`
